{"document/id":"law/442","document/type":"law","document/number":"442","document/title":"KÖY KANUNU","document/path":"data/canonical/laws/442-koy-kanunu","article/id":"law/442/article/22","article/type":"normal","article/no":"22","article/title":null,"article/path":"data/canonical/laws/442-koy-kanunu/articles/madde-022.md","text":"(Mülga: 18/1/1984 - 2972/37 md.)"}
{"document/id":"law/442","document/type":"law","document/number":"442","document/title":"KÖY KANUNU","document/path":"data/canonical/laws/442-koy-kanunu","article/id":"law/442/article/23","article/type":"normal","article/no":"23","article/title":null,"article/path":"data/canonical/laws/442-koy-kanunu/articles/madde-023.md","text":"Köyün imamı ile muallimi veya başmuallimi ihtiyar meclisinin her\nzaman azasıdırlar."}
