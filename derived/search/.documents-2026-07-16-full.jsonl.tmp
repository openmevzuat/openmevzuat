{"document/id":"law/213","document/type":"law","document/number":"213","document/title":"Vergi Usul Kanunu","document/path":"data/canonical/laws/213-vergi-usul-kanunu","article/id":"law/213/article/348","article/type":"normal","article/no":"348","article/title":null,"article/path":"data/canonical/laws/213-vergi-usul-kanunu/articles/madde-348.md","text":"(Mülga: 22/7/1998-4369/82 md.)\n\nAğır Kusurda Ceza:"}
{"document/id":"law/213","document/type":"law","document/number":"213","document/title":"Vergi Usul Kanunu","document/path":"data/canonical/laws/213-vergi-usul-kanunu","article/id":"law/213/article/349","article/type":"normal","article/no":"349","article/title":null,"article/path":"data/canonical/laws/213-vergi-usul-kanunu/articles/madde-349.md","text":"(Mülga: 22/7/1998-4369/82 md.)\n\nKusurda ceza:\nMükerrer madde 349 – (Ek: 30/12/1980-2365/75 md.; Mülga: 22/7/1998-4369/82\nmd.)\n\nTahrire dayanan vergiler ile kanuni süresi geçtikten sonra kendiliğinden verilen\nbeyannameler için kusur cezası116"}
