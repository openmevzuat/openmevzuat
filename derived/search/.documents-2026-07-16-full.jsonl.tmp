{"document/id":"law/3046","document/type":"law","document/number":"3046","document/title":"BAKAN YARDIMCILARININ MALİ HAKLARI VE BAZI DÜZENLEMELER HAKKINDA KANUN","document/path":"data/canonical/laws/3046-bakan-yardimcilarinin-mali-haklari-ve-bazi-duzenlemeler-hakkinda-kanun","article/id":"law/3046/article/3","article/type":"normal","article/no":"3","article/title":null,"article/path":"data/canonical/laws/3046-bakan-yardimcilarinin-mali-haklari-ve-bazi-duzenlemeler-hakkinda-kanun/articles/madde-003.md","text":"(Mülga: 2/7/2018-KHK-703/41 md.)"}
