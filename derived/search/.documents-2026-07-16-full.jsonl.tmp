{"document/id":"law/1608","document/type":"law","document/number":"1608","document/title":"UMURU BELEDİYEYE MÜTEALLİK AHKAMI CEZAİYE HAKKINDA 16 NİSAN 1340 TARİH VE 486 NUMARALI KANUNUN BAZI MADDELERİNİ MUADDİL KANUN","document/path":"data/canonical/laws/1608-umuru-belediyeye-muteallik-ahkami-cezaiye-hakkinda-16-nisan-1340-tarih-ve-486-numarali-kanunun-bazi-maddelerini-muaddil-kanun","article/id":"law/1608/article/6","article/type":"normal","article/no":"6","article/title":null,"article/path":"data/canonical/laws/1608-umuru-belediyeye-muteallik-ahkami-cezaiye-hakkinda-16-nisan-1340-tarih-ve-486-numarali-kanunun-bazi-maddelerini-muaddil-kanun/articles/madde-006.md","text":"(Mülga: 23/1/2008-5728/578 md.)\n\n1 Bu Kanunun, 24/6/1995 tarih ve 552 sayılı Kanun Hükmünde Kararnameye aykırı\nhükümlerinin, yaş sebze ve meyveler konusuna münhasıran uygulanmayacağı anılan\nKararname ile hükme bağlanmıştır."}
{"document/id":"law/1608","document/type":"law","document/number":"1608","document/title":"UMURU BELEDİYEYE MÜTEALLİK AHKAMI CEZAİYE HAKKINDA 16 NİSAN 1340 TARİH VE 486 NUMARALI KANUNUN BAZI MADDELERİNİ MUADDİL KANUN","document/path":"data/canonical/laws/1608-umuru-belediyeye-muteallik-ahkami-cezaiye-hakkinda-16-nisan-1340-tarih-ve-486-numarali-kanunun-bazi-maddelerini-muaddil-kanun","article/id":"law/1608/article/7","article/type":"normal","article/no":"7","article/title":null,"article/path":"data/canonical/laws/1608-umuru-belediyeye-muteallik-ahkami-cezaiye-hakkinda-16-nisan-1340-tarih-ve-486-numarali-kanunun-bazi-maddelerini-muaddil-kanun/articles/madde-007.md","text":"(Mülga: 23/1/2008-5728/578 md.)"}
