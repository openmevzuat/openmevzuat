{"document/id":"law/1309","document/type":"law","document/number":"1309","document/title":"DEVLET OPERA VE BALESİ PERSONELİ HAKKINDA KANUN","document/path":"data/canonical/laws/1309-devlet-opera-ve-balesi-personeli-hakkinda-kanun","article/id":"law/1309/article/28","article/type":"normal","article/no":"28","article/title":null,"article/path":"data/canonical/laws/1309-devlet-opera-ve-balesi-personeli-hakkinda-kanun/articles/madde-028.md","text":"Bu Kanun yayımı tarihinde yürürlüğe girer."}
{"document/id":"law/1309","document/type":"law","document/number":"1309","document/title":"DEVLET OPERA VE BALESİ PERSONELİ HAKKINDA KANUN","document/path":"data/canonical/laws/1309-devlet-opera-ve-balesi-personeli-hakkinda-kanun","article/id":"law/1309/article/29","article/type":"normal","article/no":"29","article/title":null,"article/path":"data/canonical/laws/1309-devlet-opera-ve-balesi-personeli-hakkinda-kanun/articles/madde-029.md","text":"Bu Kanunun hükümlerini Bakanlar Kurulu yürütür."}
