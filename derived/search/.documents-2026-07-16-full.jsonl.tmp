{"document/id":"law/2313","document/type":"law","document/number":"2313","document/title":"UYUŞTURUCU MADDELERİN MURAKABESİ HAKKINDA KANUN","document/path":"data/canonical/laws/2313-uyusturucu-maddelerin-murakabesi-hakkinda-kanun","article/id":"law/2313/article/28","article/type":"normal","article/no":"28","article/title":null,"article/path":"data/canonical/laws/2313-uyusturucu-maddelerin-murakabesi-hakkinda-kanun/articles/madde-028.md","text":"(Mülga: 26/7/1983-2867/28 md.)"}
